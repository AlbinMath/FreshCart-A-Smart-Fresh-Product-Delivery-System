{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/**"
        ]
      }
    },
    {
      "src": "backend/api/auth.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/**"
        ]
      }
    },
    {
      "src": "backend/api/test.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/**"
        ]
      }
    },
    {
      "src": "backend/api/health.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/auth(.*)",
      "dest": "/backend/api/auth.js"
    },
    {
      "src": "/api/users(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/api/admin(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/api/activities(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/api/upload(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/api/products(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/api/public(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/api/cart(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/api/wallet(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/api/license(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/api/notifications(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/api/addresses(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/api/payment(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/api/orders(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/api/delivery(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/api/farmer(.*)",
      "dest": "/backend/api/index.js"
    },
    {
      "src": "/api/test(.*)",
      "dest": "/backend/api/test.js"
    },
    {
      "src": "/api/health(.*)",
      "dest": "/backend/api/health.js"
    },
    {
      "src": "/(.*)",
      "dest": "/backend/api/index.js"
    }
  ]
}