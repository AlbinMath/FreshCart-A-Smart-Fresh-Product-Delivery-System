# Ignore backend directory completely
../backend/
../backend/**
backend/
backend/**

# Ignore node_modules
node_modules/

# Ignore build artifacts
dist/
.build/

# Ignore logs
*.log

# Ignore environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore test files
**/*.test.js
**/*.spec.js
**/__tests__/
**/__mocks__/

# Ignore coverage reports
coverage/

# Ignore git files
.git/
.gitignore

# Ignore cache directories
.cache/
.tmp/

# Ignore large media files
**/*.mp4
**/*.mov
**/*.avi
**/*.mkv